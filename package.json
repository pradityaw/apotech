{
  "name": "apotech",
  "version": "0.1.0",
  "private": true,
  "description": "Compliance-native pharmacy SaaS for Indonesian apotek.",
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "prisma": "prisma",
