  "keywords": [
    "pharmacy",
    "indonesia",
    "compliance",
    "satusehat",
    "bpom"
  ],
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@prisma/client": "^6.19.3",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "prisma": "^6.8.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
